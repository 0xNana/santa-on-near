# Allow only the workspace manifests, app source and entrypoint into the build context.
**
!package.json
!package-lock.json
!tsconfig.base.json
!packages/
packages/*
!packages/core/
packages/core/*
!packages/core/package.json
!packages/core/src/
!packages/core/src/**
!packages/web/
!packages/web/**
**/node_modules
**/.next
**/.next-*
**/.source
**/*.tsbuildinfo
**/.env*
**/*.swp
**/gifts
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
