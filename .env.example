# NEAR Testnet application
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ACCOUNT=
NEAR_OWNER_ACCOUNT=
NEAR_DEPLOY_KEYCHAIN=legacy
NEAR_RELAYER_ACCOUNT=
NEAR_ALLOWLISTED_TOKEN_IDS=

# Server-only sponsored-claim signer. The key must belong to NEAR_RELAYER_ACCOUNT.
# Never use the contract owner key as the hosted relayer key.
NEAR_RELAYER_SECRET_KEY=
NEAR_MAX_SPONSORED_CLAIMS_PER_HOUR=60
SANTA_PUBLIC_ORIGIN=http://localhost:3000

# Public settings bundled into the web application at build time.
NEXT_PUBLIC_NEAR_CONTRACT_ACCOUNT=
NEXT_PUBLIC_NEAR_TOKEN_ACCOUNT_IDS=

PORT=3000
